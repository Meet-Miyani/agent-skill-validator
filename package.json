{
  "name": "agent-skill-validator",
  "private": true,
  "version": "0.3.9",
  "type": "module",
  "description": "AI skill checker and agent skill validator for folders, ZIPs, .skill bundles, SKILL.md files, scripts, references, links, assets, and token budget.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "validate": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.19",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
